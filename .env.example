# 이 파일을 .env 로 복사한 뒤 값을 채운다:  cp .env.example .env
# .env 는 git과 배포에서 제외된다. 키·비밀번호를 코드나 이 예시 파일에 직접 적지 않는다.

DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 02_filesystem: 서버가 접근을 허용할 디렉터리 (절대 경로). 비우면 02_filesystem/sample_workspace
# FS_ROOT=

# 03_postgres: 읽기 전용 계정의 연결 문자열 (Postgres MCP Pro가 읽는 이름)
# 03_postgres/setup.sql 이 만드는 읽기 전용 롤(app_ro)로 접속한다. 예:
# DATABASE_URI=postgresql://app_ro:app_ro_pw@localhost:5432/postgres
